{
  "rules": {
    "chats": {
      ".read": true,
      ".indexOn": ["updatedAt"],
      "$sessionId": {
        ".write": true,
        ".validate": "newData.hasChildren(['createdAt', 'updatedAt'])",
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['who', 'text', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 800 && newData.child('who').isString()"
          }
        }
      }
    },
    "googleAccounts": {
      ".read": true,
      ".indexOn": ["lastSeenAt", "email"],
      "$uid": {
        ".write": true,
        ".validate": "newData.hasChildren(['email', 'updatedAt']) && newData.child('email').isString() && newData.child('email').val().length <= 180"
      }
    }
  }
}
